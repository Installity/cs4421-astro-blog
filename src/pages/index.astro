---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import RecentPosts from "../components/RecentPosts.astro";
import NewsFeed from "../components/NewsFeed.astro";
const posts = await getCollection("blog");
---

<SiteLayout>
  <section class="intro">
    <p class="eyebrow">Software notes · Andrei Turcan</p>
    <h1>
      Exploring software.
      <br />
      <span>Learning by building.</span>
    </h1>
    <p>
      I'm an Immersive Software Engineering student at the University of
      Limerick. This is where I share the software behind my projects, the
      decisions that shaped them, and what I learned along the way.
    </p>
  </section>
  <RecentPosts {posts} />
  <NewsFeed preview />
</SiteLayout>
<style>
  h1 span {
    color: var(--secondary);
  }
</style>
