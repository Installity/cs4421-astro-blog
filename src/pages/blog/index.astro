---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const topics = [...new Set(posts.flatMap((post) => post.data.topics))].sort();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			.topic-filter {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 2rem;
			}
			.topic-filter label {
				font-weight: 700;
			}
			.topic-filter select {
				min-width: 12rem;
				padding: 0.5rem;
				font: inherit;
				color: rgb(var(--black));
				background: white;
				border: 2px solid rgb(var(--gray-light));
				border-radius: 4px;
			}
			.topic-status {
				margin: -1rem 0 1.5rem;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.topic-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
				margin: 0.5rem 0 0;
				padding: 0;
				list-style: none;
				font-size: 0.75em;
			}
			.topic-tags li {
				width: auto;
				padding: 0.1rem 0.5rem;
				color: rgb(var(--gray-dark));
				background: rgb(var(--gray-light));
				border-radius: 999px;
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				.topic-filter {
					align-items: stretch;
					flex-direction: column;
					gap: 0.5rem;
				}
				.topic-filter select {
					width: 100%;
				}
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="topic-filter" aria-labelledby="topic-filter-label">
				<label id="topic-filter-label" for="topic-select">Filter by topic</label>
				<select id="topic-select">
					<option value="all">All topics</option>
					{topics.map((topic) => <option value={topic}>{topic}</option>)}
				</select>
			</section>
			<p class="topic-status" aria-live="polite">
				Showing <span id="post-count">{posts.length}</span> posts for <strong id="selected-topic">All topics</strong>
			</p>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li data-topics={post.data.topics.join('|')}>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<ul class="topic-tags" aria-label="Topics">
										{post.data.topics.map((topic) => <li>{topic}</li>)}
									</ul>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
		<script>
			const topicSelect = document.querySelector<HTMLSelectElement>('#topic-select');
			const postItems = document.querySelectorAll<HTMLElement>('[data-topics]');
			const postCount = document.querySelector<HTMLElement>('#post-count');
			const selectedTopic = document.querySelector<HTMLElement>('#selected-topic');

			topicSelect?.addEventListener('change', (event) => {
				const selectedValue = (event.currentTarget as HTMLSelectElement).value;
				let visiblePostCount = 0;

				postItems.forEach((postItem) => {
					const topics = postItem.dataset.topics?.split('|') ?? [];
					const isVisible = selectedValue === 'all' || topics.includes(selectedValue);
					postItem.hidden = !isVisible;
					if (isVisible) visiblePostCount += 1;
				});

				const selectedLabel = topicSelect.options[topicSelect.selectedIndex].text;
				if (postCount) postCount.textContent = String(visiblePostCount);
				if (selectedTopic) selectedTopic.textContent = selectedLabel;
			});
		</script>
	</body>
</html>
