---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const topics = [...new Set(posts.flatMap((post) => post.data.topics))].sort();
---

<SiteLayout
  title="Blog — Andrei Turcan"
  description="Personal software stories from Velsat and ExGlass."
>
  <div class="intro">
    <p class="eyebrow">Projects & lessons</p>
    <h1>From idea to implementation.</h1>
    <p>
      The software behind things I've built, and what each project taught me.
    </p>
  </div>
  <div class="filters">
    <form id="search-form" role="search">
      <label for="search-input">Search posts</label>
      <input id="search-input" type="search" placeholder="Search by keyword" />
      <button type="submit">Search</button>
    </form>
    <div>
      <label for="topic-select">Filter by topic</label>
      <select id="topic-select">
        <option value="all">All topics</option>
        {topics.map((topic) => (
          <option value={topic}>{topic}</option>
        ))}
      </select>
    </div>
  </div>
  <p class="meta" aria-live="polite">
    Showing <span id="post-count">{posts.length}</span> posts for{" "}
    <strong id="selected-topic">All topics</strong>
  </p>
  <p id="search-status" role="status" hidden>
    No results found
  </p>
  <ul class="post-list" data-post-list>
    {posts.map((post, index) => (
      <li
        data-topics={post.data.topics.join("|")}
        data-title={post.data.title}
        data-body={post.body ?? ""}
        data-index={index}
      >
        <article class="post-row">
          {post.data.heroImage && (
            <img
              src={post.data.heroImage.src}
              alt=""
              width="180"
              height="120"
            />
          )}
          <div>
            <h3 class="title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h3>
            <div class="meta">
              <FormattedDate date={post.data.pubDate} />
            </div>
            <p>{post.data.description}</p>
            <ul class="topics" aria-label="Topics">
              {post.data.topics.map((topic) => (
                <li>{topic}</li>
              ))}
            </ul>
          </div>
        </article>
      </li>
    ))}
  </ul>
  <script>
    type SearchablePost = {
      element: HTMLElement;
      title: string;
      body: string;
      topics: string[];
      index: number;
      score: number;
    };

    const topicSelect =
      document.querySelector<HTMLSelectElement>("#topic-select");
    const searchForm = document.querySelector<HTMLFormElement>("#search-form");
    const searchInput =
      document.querySelector<HTMLInputElement>("#search-input");
    const searchStatus = document.querySelector<HTMLElement>("#search-status");
    const postCount = document.querySelector<HTMLElement>("#post-count");
    const selectedTopic =
      document.querySelector<HTMLElement>("#selected-topic");
    const postList =
      document.querySelector<HTMLUListElement>("[data-post-list]");
    const postItems: SearchablePost[] = Array.from(
      document.querySelectorAll<HTMLElement>("[data-topics]"),
    ).map((element) => ({
      element,
      title: element.dataset.title ?? "",
      body: element.dataset.body ?? "",
      topics: element.dataset.topics?.split("|") ?? [],
      index: Number(element.dataset.index),
      score: 0,
    }));

    const countOccurrences = (text: string, term: string) => {
      let count = 0;
      let start = 0;
      while ((start = text.indexOf(term, start)) !== -1) {
        count += 1;
        start += term.length;
      }
      return count;
    };

    const updateResults = (query = "") => {
      const terms = query
        .toLocaleLowerCase()
        .trim()
        .split(/\s+/)
        .filter(Boolean);
      const selectedValue = topicSelect?.value ?? "all";
      let visiblePostCount = 0;

      postItems.forEach((post) => {
        const title = post.title.toLocaleLowerCase();
        const body = post.body.toLocaleLowerCase();
        const matchesSearch = terms.every(
          (term) => title.includes(term) || body.includes(term),
        );
        post.score = terms.reduce(
          (score, term) =>
            score +
            countOccurrences(title, term) * 10 +
            countOccurrences(body, term),
          0,
        );
        const matchesTopic =
          selectedValue === "all" || post.topics.includes(selectedValue);
        post.element.hidden = !matchesSearch || !matchesTopic;
        if (!post.element.hidden) visiblePostCount += 1;
      });

      postItems.sort((a, b) => b.score - a.score || a.index - b.index);
      postItems.forEach((post) => postList?.append(post.element));
      if (searchStatus)
        searchStatus.hidden = terms.length === 0 || visiblePostCount > 0;
      if (postCount) postCount.textContent = String(visiblePostCount);
      if (selectedTopic) {
        const selectedLabel =
          topicSelect?.options[topicSelect.selectedIndex]?.text;
        selectedTopic.textContent =
          terms.length > 0
            ? `Search results for "${query.trim()}"`
            : (selectedLabel ?? "All topics");
      }
    };

    searchForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      updateResults(searchInput?.value);
    });

    topicSelect?.addEventListener("change", () =>
      updateResults(searchInput?.value),
    );
  </script>
</SiteLayout>
