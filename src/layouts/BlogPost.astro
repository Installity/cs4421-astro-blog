---
import type { CollectionEntry } from "astro:content";
import SiteLayout from "./SiteLayout.astro";
import AuthorBio from "../components/AuthorBio.astro";
import FormattedDate from "../components/FormattedDate.astro";
import RelatedArticles from "../components/RelatedArticles.astro";
type Props = Omit<CollectionEntry<"blog">["data"], "author" | "topics"> & {
  author?: CollectionEntry<"authors">["data"];
  readingTime: number;
  currentPost?: Pick<CollectionEntry<"blog">, "id" | "data">;
  posts?: Pick<CollectionEntry<"blog">, "id" | "data">[];
};
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  author,
  readingTime,
  currentPost,
  posts,
} = Astro.props;
---

<SiteLayout {title} {description}>
  <article>
    <header class="article-title">
      <a href="/blog/" class="meta">
        ← All posts
      </a>
      <h1>{title}</h1>
      <p>{description}</p>
      <div class="meta">
        <FormattedDate date={pubDate} /> · {readingTime} min read
        {updatedDate && (
          <>
            {" "}
            · Updated <FormattedDate date={updatedDate} />
          </>
        )}
      </div>
      {heroImage && (
        <img
          class="article-diagram"
          src={heroImage.src}
          width="680"
          height="260"
          alt={
            title.startsWith("Velsat")
              ? "Sensor readings flow through Arduino firmware and radio telemetry to a team ground station."
              : "Camera frames stream over Wi-Fi to laptop processing, which sends alerts to an onboard board."
          }
        />
      )}
    </header>
    <div class="prose">
      <slot />
      {author && <AuthorBio {...author} />}{" "}
      {currentPost && posts && <RelatedArticles {currentPost} {posts} />}
    </div>
  </article>
</SiteLayout>
