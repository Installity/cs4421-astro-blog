---
import { NEWS_SOURCES } from "../lib/news";
interface Props {
  preview?: boolean;
}
const { preview = false } = Astro.props;
const runtime =
  import.meta.env.DEV || import.meta.env.ASTRO_OUTPUT === "server";
const configured = import.meta.env.PUBLIC_NEWS_API_URL ?? "";
let endpoint = runtime ? "/api/news" : "";
if (!runtime && configured) {
  try {
    const url = new URL(configured);
    if (url.protocol === "https:" && !url.username && !url.password)
      endpoint = url.href;
  } catch {
    /* Configuration is explained in the unavailable state. */
  }
}
---

<section
  class="news-section"
  aria-labelledby="news-heading"
  data-news-feed
  data-endpoint={endpoint}
  data-limit={preview ? 6 : 60}
>
  <div class="section-heading">
    <h2 id="news-heading">
      {preview ? "Latest tech news" : "From the publishers"}
    </h2>
    {preview && <a href="/news/">All tech news ↗</a>}
  </div>
  <p class="news-note">
    Headlines from independent publishers. Read each story on its original site.
  </p>
  <div class="news-controls">
    {!preview && (
      <>
        <label for="news-publisher">Publisher</label>
        <select id="news-publisher" data-news-filter>
          <option value="all">All publishers</option>
          {NEWS_SOURCES.map((s) => (
            <option value={s.id}>{s.name}</option>
          ))}
        </select>
      </>
    )}
    <button type="button" data-news-retry hidden>
      <svg
        class="news-refresh-icon"
        aria-hidden="true"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M20 7v5h-5M4 17v-5h5" />
        <path d="M6.1 7a7 7 0 0 1 11.6-1L20 9M4 15l2.3 3A7 7 0 0 0 17.9 17" />
      </svg>
      <span data-news-refresh-label>Refresh news</span>
    </button>
  </div>
  <p class="news-status" data-news-status role="status" aria-atomic="true">
    {endpoint
      ? "Loading the latest headlines…"
      : "Live news is unavailable on this version of the site. A news API URL has not been configured."}
  </p>
  <ul class="news-list" data-news-list aria-busy="false"></ul>
  <p class="meta" data-news-checked></p>
  <details class="source-status" data-news-sources hidden>
    <summary>Publisher availability</summary>
    <ul></ul>
  </details>
  <noscript>
    <p class="news-note">
      Enable JavaScript to load current headlines, or visit a publisher
      directly.
    </p>
    <ul>
      {NEWS_SOURCES.map((s) => (
        <li>
          <a href={new URL(s.url).origin}>{s.name}</a>
        </li>
      ))}
    </ul>
  </noscript>
</section>
<script>
  import "../scripts/news-client";
</script>
