---
import HeaderLink from "./HeaderLink.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header>
  <a class="identity" href="/" aria-label="Andrei Turcan, home">
    <span aria-hidden="true">⠿</span> Andrei Turcan
  </a>
  <nav aria-label="Main navigation">
    <HeaderLink href="/">Home</HeaderLink>
    <HeaderLink href="/blog/">Blog</HeaderLink>
    <HeaderLink href="/news/">Tech News</HeaderLink>
    <HeaderLink href="/about/">About</HeaderLink>
  </nav>
  <ThemeToggle />
  <button
    type="button"
    class="motion-toggle"
    data-motion-toggle
    hidden
    aria-label="Pause background"
    aria-pressed="false"
    title="Pause background"
  >
    <span aria-hidden="true">Ⅱ</span>
  </button>
</header>
<style>
  header {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .identity {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.04em;
    text-decoration: none;
    color: var(--text);
    margin-right: auto;
  }
  .identity span {
    color: var(--accent);
    margin-right: 8px;
  }
  nav {
    display: flex;
    gap: 16px;
    font-size: 13px;
  }
  nav :global(a) {
    color: var(--secondary);
    text-decoration: none;
    padding: 8px 0;
  }
  nav :global(a.active) {
    color: var(--accent);
  }
  .motion-toggle {
    padding: 0;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    font-size: 16px;
    line-height: 1;
  }
  .motion-toggle:disabled {
    opacity: 0.6;
    cursor: default;
  }
  @media (max-width: 700px) {
    header {
      gap: 10px;
    }
    .identity {
      font-size: 18px;
    }
    nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 10px;
    }
  }
</style>
