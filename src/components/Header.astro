---
import HeaderLink from "./HeaderLink.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header>
  <a class="identity" href="/" aria-label="Andrei Turcan, home">
    <span aria-hidden="true">⠿</span> Andrei Turcan
  </a>
  <nav aria-label="Main navigation">
    <HeaderLink href="/">Home</HeaderLink>
    <HeaderLink href="/blog/">Blog</HeaderLink>
    <HeaderLink href="/news/">Tech News</HeaderLink>
    <HeaderLink href="/about/">About</HeaderLink>
  </nav>
  <ThemeToggle />
  <button
    type="button"
    class="motion-toggle"
    data-motion-toggle
    hidden
    aria-label="Pause background"
    aria-pressed="false"
    title="Pause background"
    data-motion-state="running"
    transition:persist="motion-toggle"
  >
    <svg data-motion-icon="pause" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
      <path d="M7 5h4v14H7zM14 5h4v14h-4z" />
    </svg>
    <svg data-motion-icon="play" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
      <path d="M8 5v14l11-7z" />
    </svg>
  </button>
</header>
<style>
  header {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .identity {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.04em;
    text-decoration: none;
    color: var(--text);
    margin-right: auto;
  }
  .identity span {
    color: var(--accent);
    margin-right: 8px;
  }
  nav {
    display: flex;
    gap: 16px;
    font-size: 13px;
  }
  nav :global(a) {
    color: var(--secondary);
    text-decoration: none;
    padding: 8px 0;
  }
  nav :global(a.active) {
    color: var(--accent);
  }
  .motion-toggle {
    display: grid;
    place-items: center;
    padding: 0;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    font-size: 16px;
    line-height: 1;
  }
  .motion-toggle:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .motion-toggle svg {
    grid-area: 1 / 1;
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .motion-toggle [data-motion-icon="play"] {
    opacity: 0;
    transform: scale(0.6) rotate(-20deg);
  }
  .motion-toggle[data-motion-state="paused"] [data-motion-icon="pause"] {
    opacity: 0;
    transform: scale(0.6) rotate(20deg);
  }
  .motion-toggle[data-motion-state="paused"] [data-motion-icon="play"] {
    opacity: 1;
    transform: scale(1) rotate(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .motion-toggle svg {
      transition: none;
    }
  }
  @media (max-width: 700px) {
    header {
      gap: 10px;
    }
    .identity {
      font-size: 18px;
    }
    nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 10px;
    }
  }
</style>
