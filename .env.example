# Static builds only: complete HTTPS endpoint on a running Astro server.
# Leave empty to show the news unavailable state on the static site.
# Production workflow default: https://as-2b62f684bea24081892fa30f44c134ca.ecs.us-east-1.on.aws/api/news
PUBLIC_NEWS_API_URL=

# Server runtime only: comma-separated exact origins permitted to read news.
# Production origins: https://d2lpj15qx37gqq.cloudfront.net,https://andreitrn.me,https://www.andreitrn.me
NEWS_ALLOWED_ORIGINS=

# Set to server for the Node/container build; omit for the default static build.
# ASTRO_OUTPUT=server
# Preferred public site URL for canonical links, RSS, and sitemap (build time).
# Static default: https://andreitrn.me; server default: https://ssr.andreitrn.me.
# Leave empty to use the default for the selected build output.
PUBLIC_SITE_URL=
