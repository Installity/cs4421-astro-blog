{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployOnlyAstroBlogService",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeExpressGatewayService",
        "ecs:UpdateExpressGatewayService",
        "ecs:DescribeServices"
      ],
      "Resource": "arn:aws:ecs:us-east-1:873716897321:service/default/astro-blog",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}
    },
    {
      "Sid": "RegisterOnlyAstroBlogTaskRevisions",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "arn:aws:ecs:us-east-1:873716897321:task-definition/default-astro-blog:*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}
    },
    {
      "Sid": "PassOnlyExistingTaskRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::873716897321:role/ecsTaskExecutionRole",
      "Condition": {"StringEquals": {"iam:PassedToService": "ecs-tasks.amazonaws.com"}}
    }
  ]
}
