{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageAstroBlogService",
      "Effect": "Allow",
      "Action": ["ecs:DescribeServices", "ecs:UpdateService"],
      "Resource": "arn:aws:ecs:us-east-1:873716897321:service/default/astro-blog"
    },
    {
      "Sid": "ReadRegionalInfrastructureState",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAccountAttributes",
        "ec2:DescribeInternetGateways",
        "cloudwatch:DescribeAlarms"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {"aws:RequestedRegion": "us-east-1"}
      }
    },
    {
      "Sid": "DiscoverAstroBlogVpcSecurityGroups",
      "Effect": "Allow",
      "Action": "ec2:GetSecurityGroupsForVpc",
      "Resource": "arn:aws:ec2:us-east-1:873716897321:vpc/vpc-083ecb80b6137a495"
    },
    {
      "Sid": "ManageAstroBlogScalingAlarms",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricAlarm",
      "Resource": "arn:aws:cloudwatch:us-east-1:873716897321:alarm:TargetTracking-service/default/astro-blog-*"
    }
  ]
}
